table
  tr
    th ID     
    th Body 
    th Author id
    th Email
    th Rating
    th Dislikes
    th Files
  tr

  tr
    td= answer.id
    td= link_to answer.body, answer_path(answer) 
    td= answer.author&.id
    td= answer.author&.email 
    td data-answer-id=answer.id data-answer-view="true"
      = answer.view_votes(current_user) 
    - if answer.files.attached?
      - answer.files.each do |file|
        td= link_to file.filename.to_s, url_for(file)
        td= link_to 'delete file', attachment_path(file), method: 'delete'
    - else
      td= 'no file'
    - if answer.best   
      td.best 
        div id="best-#{answer.id}"
          p Best answer
    - else
      td=

    - if can? :update, answer
      td= link_to 'Edit', edit_answer_path(answer), data: { answer_id: answer.id }
    
    - if can? :set_best, answer
      td= link_to 'Set Best', set_best_answer_path(answer), data: { method: :post }, id: answer.id      
    
    - if can? :like, answer
      td
        = link_to 'Like', \
                  vote_answer_path(answer, decision: true), \
                  method: :post, \
                  remote: true, \
                  format: :json, \
                  data: { \
                    answer_id: answer.id, \
                    vote_type: "like" \
                  }
      td
        = link_to 'Dislike', \
                  vote_answer_path(answer, decision: false), \
                  remote: true, \
                  method: :post, \
                  format: :json, \
                  data: { \
                    answer_id: answer.id, \
                    vote_type: "dislike" \
                  }

    td= form_with model: answer, class: 'hidden', html: { id: "edit-answer-#{answer.id}" } do |f|
        = f.label :update, 'Your answer'
        = f.text_area :body
        = f.file_field :files, multiple: true
        = f.fields_for :links do |l|
          p
            = l.label :title
            = l.text_field :title
          p
            = l.label :url
            = l.text_field :url
        = f.submit 'Save'
  tr


