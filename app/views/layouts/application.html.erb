<!DOCTYPE html>
<html>
  <head>
    <title>Qna</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag :application, 'data-turbolinks-track': 'reload', async: false %>

    <% flash.each do |type, msg| %>
      <div class="flash flash-notice" data-controller="flash" data-flash-type="notice">
        <%= msg %>
      </div>
    <% end %>  
  </head>

  <div class="search-bar">
    <%= form_with url: search_path, method: :get, local: true do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Поиск по сайту...", required: true %>
      <%= f.button "Search", type: :submit %>
    <% end %>
  </div>

  <%= render 'shared/log_out' %>

  <body data-logged-in="<%= user_signed_in? %>" 
        data-current-user-id="<%= current_user&.id %>">
    <%= yield %>
  </body>
</html>
